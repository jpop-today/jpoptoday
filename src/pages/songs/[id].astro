---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { songs, songHref, type Song } from '../../lib/catalog';
import { hasConfirmedNumber } from '../../../contracts/public-catalog.mjs';
import { artistPageFor, metadataFor, sameArtistSongs, chartNeighbors, chartRankFor, introExcerpt, isConfirmed, songJsonLd } from '../../lib/song-context';
import { artistHref } from '../../../contracts/artists.mjs';
export function getStaticPaths() { return songs.map(song => ({ params: { id: song.id }, props: { song } })); }
const { song } = Astro.props as { song: Song };
const conflict = song.karaoke.tj.conflict || song.karaoke.ky.conflict;
const artistPage = artistPageFor(song);
const meta = metadataFor(song);
const sameArtist = sameArtistSongs(song);
const neighbors = chartNeighbors(song);
const rank = chartRankFor(song);
const excerpt = introExcerpt(artistPage);
const providerName = { tj: 'TJ', ky: '금영' } as const;
// One plain sentence per provider, derived only from the reviewed status.
const statusLines = (['tj', 'ky'] as const).map(provider => {
  const value = song.karaoke[provider];
  if (value.conflict) return `${providerName[provider]}: 같은 번호를 쓰는 다른 항목이 있어 번호 표시를 보류했습니다.`;
  if (hasConfirmedNumber(song, provider) && value.evidence) return `${providerName[provider]}: 공식 번호 검색에서 제목·가수를 대조해 확인했습니다 (${value.evidence.checkedAt.slice(0, 10)}).`;
  if (value.observedNumber) return `${providerName[provider]}: 기존 관리 자료의 관측 번호이며 아직 공식 대조 전입니다.`;
  return `${providerName[provider]}: 확인된 번호가 없습니다. 미수록을 뜻하지 않습니다.`;
});
const report = 'mailto:nossee160@gmail.com?subject=' + encodeURIComponent('jpop.today 곡 정보 제보: ' + song.titleOriginal) + '&body=' + encodeURIComponent(`${song.titleOriginal} / ${song.artistOriginal}\n곡 주소: https://jpop.today${songHref(song.id)}\n업체와 확인한 번호·출처:\n`);
---
<Layout title={`${song.titleOriginal} · ${song.artistOriginal} 노래방 번호`} canonicalPath={songHref(song.id)} song={song}>
  <script slot="head" type="application/ld+json" is:inline set:html={songJsonLd(song, artistPage, meta)} />
  <article class="reading song-detail"><a class="back-link" href="/search/">← 노래 찾기</a><h1>{song.titleOriginal}</h1>{song.titleKo && <p class="song-korean">{song.titleKo}</p>}<p class="artist">{artistPage ? <a href={artistHref(artistPage.slug)}>{song.artistOriginal}</a> : song.artistOriginal}{song.artistKo && ` · ${song.artistKo}`}</p>
    <div class="detail-numbers">{(['tj', 'ky'] as const).map(provider => {
      const value = song.karaoke[provider];
      return <section><h2>{provider === 'tj' ? 'TJ' : '금영'}</h2>
        {value.conflict ?
          <><p class="unknown">번호 충돌 · 재확인 필요</p><p>다른 항목과의 번호 충돌이 해결될 때까지 번호 표시와 복사를 보류합니다. 미수록을 뜻하지 않습니다.</p></> : value.observedNumber ?
          <><button class="number-button" type="button" data-copy={value.observedNumber} aria-label={`${provider} 번호 복사`}>{value.observedNumber}<Icon name="copy" /></button><p>{hasConfirmedNumber(song, provider) ? '공식 검색에서 확인' : '관측 번호 · 재확인 필요'}</p></> :
          <><p class="unknown">확인 필요</p><p>확인된 번호가 없습니다. 미수록을 뜻하지 않습니다.</p></>}
        {value.correction && <p class="verification-note">{value.correction.reason}</p>}
        {value.evidence && <p class="verification-note"><a href={value.evidence.url} rel="noopener noreferrer" target="_blank">공식 대조 결과</a><br />{value.evidence.title} · {value.evidence.artist}<br />확인일: {value.evidence.checkedAt}</p>}
      </section>;
    })}</div>
    {conflict && <p class="notice">같은 번호를 가진 다른 항목이 목록에 있습니다. 원제와 가수를 공식 검색에서 대조한 뒤 예약하세요.</p>}
    {song.availability === 'archived' && <p class="notice">이전 목록에 보관된 곡입니다. 현재 기본 검색에서는 제외되며 저장한 주소로 조회할 수 있습니다.</p>}
    <button class="detail-save secondary-button" type="button" disabled data-save={song.id} aria-pressed="false"><Icon name="star" /> 즐겨찾기 저장</button>
    <section><h2>번호를 확인하는 방법</h2><p>공식 확인 표시에는 제목·가수를 대조한 근거와 확인일을 제공합니다. 나머지 관측 번호는 기존 관리 자료의 값이며 최신 공식 확인이 완료된 정보는 아닙니다. 방문할 기기의 업체와 곡 버전을 함께 확인하세요.</p><p><a href="https://www.tjmedia.com/song/accompaniment_search" rel="noopener noreferrer" target="_blank">TJ 공식 곡 검색</a> · <a href="https://www.kygabang.com/" rel="noopener noreferrer" target="_blank">금영 공식 곡 검색</a></p><p><!--email_off--><a href={report}>이 곡 정보 제보</a><!--/email_off--> · <a href="/guides/tj-ky-numbers/">TJ와 금영 번호 이용 가이드</a></p></section>
    <section aria-labelledby="status-heading"><h2 id="status-heading">이 곡의 확인 상태</h2><ul>{statusLines.map(line => <li>{line}</li>)}</ul></section>
    {meta && <section aria-labelledby="info-heading"><h2 id="info-heading">곡 정보</h2><ul>
      {meta.releaseYear && <li>발매: {meta.releaseYear}년</li>}{meta.album && <li>앨범: {meta.album}</li>}{meta.tieup && <li>타이업: {meta.tieup}</li>}
    </ul><p class="verification-source"><a href={meta.source} rel="noopener noreferrer" target="_blank">정보 출처</a></p></section>}
    {artistPage && <section aria-labelledby="artist-heading"><h2 id="artist-heading">{artistPage.name}</h2>
      {excerpt && <blockquote class="artist-excerpt"><p>{excerpt}</p></blockquote>}
      <p><a href={artistHref(artistPage.slug)}>{artistPage.name} 전곡 노래방 번호 보기 ({artistPage.songs.length}곡, 공식 확인 {artistPage.confirmedCount}곡)</a></p></section>}
    {sameArtist.length > 0 && <section aria-labelledby="same-artist-heading"><h2 id="same-artist-heading">같은 가수의 다른 곡</h2>
      <ul class="related-songs">{sameArtist.map(other => <li><a href={songHref(other.id)}>{other.titleOriginal}</a>{isConfirmed(other) && <span class="related-badge"> · 번호 대조 완료</span>}</li>)}</ul></section>}
    {rank && neighbors.length > 0 && <section aria-labelledby="chart-heading"><h2 id="chart-heading">TJ 차트에서 가까운 곡</h2>
      <p>보관된 TJ JPOP 차트에서 이 곡은 {rank}위였습니다. <a href={`/chart/#chart-${song.id}`}>차트 기록 보기</a></p>
      <ol class="related-songs">{neighbors.map(item => <li><span class="related-rank">{item.rank}위</span> <a href={songHref(item.song.id)}>{item.song.titleOriginal}</a> · {item.song.artistOriginal}</li>)}</ol></section>}
  </article>
</Layout>

<style>
  .related-songs { padding-left: 20px; }
  .related-badge, .related-rank { color: #535d6d; font-size: 14px; }
  .artist-excerpt { margin: 12px 0; padding-left: 16px; border-left: 3px solid #d6e2fa; }
</style>
