---
import Layout from '../layouts/Layout.astro';
import { songs, songHref } from '../lib/catalog';
import { buildConfirmedArtistGroups, confirmedNumbers } from '../../contracts/confirmed-discovery.mjs';

const providerLabel = { tj: 'TJ', ky: '금영' };
const providers = ['tj', 'ky'] as const;
const countProviders = (groupSongs: typeof songs) => {
  const ids = { tj: new Set<string>(), ky: new Set<string>() };
  for (const song of groupSongs) {
    for (const number of confirmedNumbers(song)) ids[number.provider].add(song.id);
  }
  const both = [...ids.tj].filter(id => ids.ky.has(id)).length;
  return { tj: ids.tj.size, ky: ids.ky.size, both };
};
const groups = buildConfirmedArtistGroups(songs).map(group => ({ ...group, counts: countProviders(group.songs) }));
const directorySongs = groups.flatMap(group => group.songs);
const songCount = new Set(directorySongs.map(song => song.id)).size;
const providerCounts = countProviders(directorySongs);
const numberCount = providerCounts.tj + providerCounts.ky;
const checkedTime = new Intl.DateTimeFormat('ko-KR', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Seoul' });
const formatCount = (count: number) => count.toLocaleString('ko-KR');
---
<Layout title="가수별 공식 확인곡" description="공식 검색으로 대조한 JPOP 노래방 번호를 가수별로 찾아보세요. TJ·금영 근거와 실제 대조 시각, 버전 확인 방법을 함께 제공합니다.">
  <article class="reading artist-directory">
    <header class="directory-intro">
      <p class="eyebrow">아는 가수부터, 확인한 번호까지</p>
      <h1>가수별 공식 확인곡</h1>
      <p class="directory-lead">좋아하는 가수를 골라 노래를 찾아보세요. 공식 검색의 제목·가수를 대조한 번호와 각 곡의 상세 정보를 함께 볼 수 있습니다.</p>
      <a class="directory-start" href="#artist-index">가수 목록으로 바로가기 <span aria-hidden="true">↓</span></a>
      <dl class="directory-summary" aria-label="이 페이지의 확인 범위">
        <div><dt>가수 표기</dt><dd data-directory="artists">{formatCount(groups.length)}<span>개</span></dd></div>
        <div><dt>확인곡 ID</dt><dd data-directory="songs">{formatCount(songCount)}<span>개</span></dd></div>
        <div><dt>공식 대조 번호</dt><dd data-directory="numbers">{formatCount(numberCount)}<span>건</span></dd></div>
      </dl>
      <dl class="provider-summary" aria-label="업체별 공식 확인곡 수" aria-describedby="provider-count-note">
        {providers.map(provider => <div><dt>{providerLabel[provider]} 공식 확인곡</dt><dd data-provider-count="global" data-provider={provider} data-count={providerCounts[provider]}>{formatCount(providerCounts[provider])}<span>개 ID</span></dd></div>)}
        <div class="both-provider-summary"><dt>TJ·금영 모두 확인</dt><dd data-provider-count="global" data-provider="both" data-count={providerCounts.both}>{formatCount(providerCounts.both)}<span>개 ID</span></dd></div>
      </dl>
      <p class="both-search-action"><a href="/search/?number=confirmed-tj&number=confirmed-ky" data-confirmed-both-search aria-describedby="both-search-note">TJ·금영 모두 확인된 곡 검색 <span aria-hidden="true">→</span></a></p>
      <p class="both-search-note" id="both-search-note">두 업체 모두 확인은 같은 곡 ID에 TJ와 금영의 공식 근거가 각각 있는 조건입니다. 검색에서는 두 조건을 함께 적용하며, 검색·필터 사용에는 JavaScript가 필요합니다. JavaScript 없이도 아래 가수별 확인 수와 곡·공식 근거는 볼 수 있습니다.</p>
      <p class="directory-scope">현재 관리 목록 중 공식 근거가 있고 번호 충돌이 없는 일부 곡만 모았습니다. 전체 확인곡 ID는 두 업체에서 확인한 곡을 중복 없이 센 수입니다. 같은 곡이 TJ와 금영에 모두 확인되면 업체별로는 각각 1곡, 전체에서는 1곡으로 셉니다. 별도 곡 ID·버전은 그대로 구분하며, 업체의 전체 수록곡 목록을 뜻하지 않습니다. <a href="/coverage/">전체 관리 목록의 확인 범위 보기</a></p>
      <p class="provider-count-note" id="provider-count-note">0개는 이 관리 목록에서 해당 업체 또는 두 업체 모두의 확인 조건에 맞는 곡이 아직 없다는 뜻이며, 공식 미수록을 뜻하지 않습니다.</p>
    </header>

    <section class="directory-help" aria-labelledby="choosing-song-heading">
      <h2 id="choosing-song-heading">같은 가수, 다른 버전을 구분하는 방법</h2>
      <ol>
        <li><strong>부를 제목과 버전을 먼저 고르세요.</strong> 영화판·원곡·커버가 별도 항목일 수 있습니다. 관리 목록의 곡명과 아래 공식 표기를 비교하고, 제목이 비슷하면 상세에서 정정 이유를 확인하세요.</li>
        <li><strong>방문할 기기의 업체를 확인하세요.</strong> TJ와 금영 번호는 서로 바꿔 쓸 수 없습니다. 확인된 업체의 번호와 대조 시각을 보고, 공식 검색 링크에서 현재 표기를 다시 확인하세요.</li>
        <li><strong>다른 표기는 전체 검색에서도 찾아보세요.</strong> 이 페이지는 저장된 가수 원문 표기가 같은 곡끼리 묶습니다. 공동명의·별칭·다른 표기를 같은 가수로 추정해 합치지 않으며, 한글 표기도 기존 자료에 있는 값만 보여 줍니다.</li>
      </ol>
      <p><a href="/guides/checking-song-numbers/">실제 정정 사례로 보는 번호 확인 방법 <span aria-hidden="true">↗</span></a></p>
    </section>

    <div class="directory-body">
      <nav class="artist-index" id="artist-index" aria-label="가수 바로가기">
        <h2>가수 바로가기</h2>
        <ul>{groups.map(group => <li><a href={`#${group.id}`} data-artist-index={group.id} aria-describedby="provider-count-note"><span class="index-heading"><span>{group.name}</span><span class="index-count">{group.songs.length}곡</span></span><span class="index-provider-counts">{providers.map(provider => <span data-provider-count="index" data-provider={provider} data-count={group.counts[provider]}>{providerLabel[provider]} {formatCount(group.counts[provider])}<span class="sr-only">개 공식 확인곡 ID</span></span>)}<span class="index-both-count" data-provider-count="index" data-provider="both" data-count={group.counts.both}>TJ·금영 모두 {formatCount(group.counts.both)}<span class="sr-only">개 공식 확인곡 ID</span></span></span></a></li>)}</ul>
        <a class="search-link" href="/search/">전체 노래 검색 <span aria-hidden="true">→</span></a>
      </nav>

      <div class="artist-groups">
        {groups.length === 0 && <p class="directory-empty">현재 표시할 수 있는 공식 확인곡이 없습니다. <a href="/search/">전체 검색</a>에서 관측 번호와 확인 필요 상태를 구분해 찾아보세요.</p>}
        {groups.map(group => <section class="artist-group" id={group.id} data-artist-group data-artist-name={group.name} aria-labelledby={`${group.id}-heading`}>
          <header class="artist-heading">
            <p class="group-label">관리 목록의 가수 표기</p>
            <h2 id={`${group.id}-heading`}>{group.name}</h2>
            {group.namesKo.length > 0 && <p class="artist-korean">기존 한글 표기: {group.namesKo.join(' · ')}</p>}
            <p class="group-count">공식 확인곡 {group.songs.length}개 ID</p>
            <div class="group-provider-counts" role="group" aria-label="업체별 공식 확인곡 수" aria-describedby="provider-count-note">{providers.map(provider => <span data-provider-count="group" data-provider={provider} data-count={group.counts[provider]}>{providerLabel[provider]} <strong>{formatCount(group.counts[provider])}</strong>개 ID</span>)}<span data-provider-count="group" data-provider="both" data-count={group.counts.both}>TJ·금영 모두 <strong>{formatCount(group.counts.both)}</strong>개 ID</span></div>
          </header>
          <ul class="artist-song-list">
            {group.songs.map(song => {
              const numbers = confirmedNumbers(song);
              const pendingProviders = providers.filter(provider => !numbers.some(number => number.provider === provider));
              return <li class="artist-song" data-song-id={song.id}>
                <h3><a class="artist-song-link" href={songHref(song.id)}>{song.titleOriginal} <span aria-hidden="true">→</span></a></h3>
                {song.titleKo && <p class="song-korean-label">{song.titleKo}</p>}
                <div class="artist-numbers">{numbers.map(({ provider, number, evidence }) => <section class="artist-number" data-provider={provider} data-confirmed-number aria-label={`${providerLabel[provider]} 공식 확인 번호`}>
                  <p class="number-heading"><span>{providerLabel[provider]}</span><strong class="artist-number-value">{number}</strong></p>
                  <p class="official-identity">공식 표기: {evidence.title} · {evidence.artist}</p>
                  <p class="evidence-time">대조: <time datetime={evidence.checkedAt}>{checkedTime.format(new Date(evidence.checkedAt))}</time> (한국 시간)</p>
                  <a class="artist-evidence" href={evidence.url} target="_blank" rel="noopener noreferrer">{providerLabel[provider]} 공식 근거 <span class="sr-only">(새 탭)</span><span aria-hidden="true">↗</span></a>
                </section>)}</div>
                {pendingProviders.length > 0 && <p class="pending-provider">{pendingProviders.map(provider => `${providerLabel[provider]}: ${song.karaoke[provider].status === 'unknown' ? '확인 필요 · 미수록을 뜻하지 않습니다' : song.karaoke[provider].conflict ? '번호 충돌 · 상세에서 확인하세요' : '관측 번호 · 공식 재확인 필요'}`).join(' / ')}. <a href={songHref(song.id)}>곡 상세에서 상태 보기</a></p>}
              </li>;
            })}
          </ul>
        </section>)}
      </div>
    </div>

    <aside class="directory-note" aria-labelledby="directory-unknown-heading">
      <h2 id="directory-unknown-heading">찾는 가수나 번호가 보이지 않나요?</h2>
      <p>이 페이지에 없는 곡도 관리 목록에 있을 수 있습니다. ‘확인 필요’는 번호 근거가 부족하거나 표시를 보류한 상태이며 미수록을 뜻하지 않습니다. 확인되지 않은 관측 번호는 이 페이지의 공식 번호로 표시하지 않습니다.</p>
      <p class="directory-actions"><a href="/search/">한글·원제·가수로 검색</a><a href="/coverage/">번호 확인 범위 알아보기</a><a href="/contact/">근거와 함께 정정 제보</a></p>
    </aside>
  </article>
</Layout>

<style>
  .artist-directory { max-width: 1088px; }
  .directory-intro { position: relative; padding: 28px 32px 24px; border: 1px solid #d8dce4; border-radius: 16px; background: #ffffffbd; }
  .directory-intro::before { content: ''; position: absolute; top: -1px; left: 24px; right: 24px; height: 4px; border-radius: 0 0 6px 6px; background: linear-gradient(135deg, #4f7cff, #ff7aa8); }
  .artist-directory .eyebrow { margin: 0 0 12px; color: #284fc7; font-size: 14px; font-weight: 650; }
  .artist-directory .directory-lead { max-width: 720px; margin: 16px 0 0; }
  .artist-directory .directory-start { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; margin-top: 8px; font-size: 15px; font-weight: 650; }
  .directory-summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 24px 0 16px; }
  .directory-summary div { border-left: 2px solid #d6e2fa; padding-left: 16px; }
  .directory-summary dt { color: #535d6d; font-size: 14px; }
  .directory-summary dd { margin: 8px 0 0; color: #20242c; font-size: 30px; font-weight: 750; font-variant-numeric: tabular-nums; }
  .directory-summary dd span { margin-left: 6px; color: #535d6d; font-size: 14px; font-weight: 400; }
  .provider-summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 0 0 16px; padding-top: 18px; border-top: 1px solid #e6e7eb; }
  .provider-summary div { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 12px; }
  .provider-summary dt { color: #535d6d; font-size: 14px; }
  .provider-summary dd { margin: 0; color: #284fc7; font-size: 22px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .provider-summary dd span { margin-left: 6px; color: #535d6d; font-size: 12px; font-weight: 400; }
  .artist-directory .both-search-action { margin: 0; }
  .both-search-action a { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; padding: 0 12px; border: 1px solid #c8ded8; border-radius: 8px; background: #e7f5ef; font-size: 14px; font-weight: 650; }
  .artist-directory .both-search-note { margin: 10px 0 16px; color: #535d6d; font-size: 13px; line-height: 1.8; }
  .artist-directory .directory-scope { margin: 0; font-size: 14px; line-height: 1.8; }
  .artist-directory .provider-count-note { margin: 12px 0 0; font-size: 13px; line-height: 1.8; color: #535d6d; }
  .directory-help { margin: 32px 0 40px; padding: 0 4px; }
  .artist-directory .directory-help h2 { margin-top: 0; }
  .directory-help ol { padding-left: 24px; }
  .directory-help li { margin: 12px 0; font-size: 15px; }
  .directory-help strong { color: #20242c; }
  .directory-help p { margin-bottom: 0; }
  .directory-body { display: grid; grid-template-columns: 236px minmax(0, 1fr); gap: 32px; align-items: start; }
  .artist-index { min-width: 0; padding: 20px; background: #edf2ffab; border: 1px solid #d6e2fa; border-radius: 12px; scroll-margin-top: 24px; }
  .artist-directory .artist-index h2 { margin: 0 0 12px; font-size: 19px; }
  .artist-index ul { padding: 0; margin: 0; list-style: none; }
  .artist-directory .artist-index li { font-size: 14px; }
  .artist-directory .artist-index a { display: flex; flex-direction: column; gap: 4px; min-height: 44px; padding: 10px 0; text-decoration: none; overflow-wrap: anywhere; }
  .artist-index a span:first-child { min-width: 0; }
  .index-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .index-provider-counts { display: flex; flex-wrap: wrap; gap: 4px 12px; color: #535d6d; font-size: 12px; font-variant-numeric: tabular-nums; }
  .index-both-count { flex-basis: 100%; }
  .artist-directory .artist-index a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .index-count { flex-shrink: 0; color: #535d6d; font-size: 12px; font-variant-numeric: tabular-nums; }
  .artist-directory .artist-index .search-link { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 12px; padding-top: 16px; border-top: 1px solid #d6e2fa; font-weight: 650; }
  .artist-groups { min-width: 0; }
  .artist-group { scroll-margin-top: 24px; padding: 24px 28px; margin-bottom: 24px; border: 1px solid #d8dce4; border-radius: 12px; background: #ffffffc9; }
  .artist-directory .group-label { margin: 0 0 4px; color: #535d6d; font-size: 12px; }
  .artist-directory .artist-heading h2 { margin: 0; font-size: 27px; line-height: 1.45; overflow-wrap: anywhere; }
  .artist-directory .artist-korean { margin: 4px 0 0; font-size: 14px; }
  .artist-directory .group-count { margin: 12px 0 0; color: #284fc7; font-size: 13px; }
  .artist-directory .group-provider-counts { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 8px 0 0; color: #535d6d; font-size: 13px; font-variant-numeric: tabular-nums; }
  .group-provider-counts strong { color: #20242c; }
  .artist-song-list { padding: 0; margin: 16px 0 0; list-style: none; }
  .artist-song { padding: 20px 0; border-top: 1px solid #e6e7eb; }
  .artist-song:last-child { padding-bottom: 0; }
  .artist-song h3 { margin: 0; font-size: 20px; line-height: 1.5; overflow-wrap: anywhere; }
  .artist-directory .artist-song-link { display: inline-flex; align-items: baseline; gap: 12px; min-height: 44px; }
  .artist-song-link span { flex-shrink: 0; font-size: 16px; }
  .artist-directory .song-korean-label { margin: 0 0 12px; font-size: 14px; }
  .artist-numbers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .artist-number { min-width: 0; padding: 14px 16px 8px; border: 1px solid #d8dce4; border-radius: 8px; background: #f7faff; }
  .artist-directory .number-heading { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12px; margin: 0; color: #20242c; }
  .number-heading span { font-size: 13px; font-weight: 650; }
  .artist-number-value { font-size: 25px; font-variant-numeric: tabular-nums; }
  .artist-directory .official-identity, .artist-directory .evidence-time { margin: 8px 0 0; font-size: 12px; line-height: 1.8; }
  .artist-directory .artist-evidence { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-size: 13px; }
  .artist-directory .pending-provider { margin: 12px 0 0; font-size: 13px; }
  .directory-note { margin-top: 24px; padding: 24px 28px; border-left: 4px solid #4f7cff; border-radius: 0 10px 10px 0; background: #edf2ff; }
  .artist-directory .directory-note h2 { margin: 0 0 12px; font-size: 22px; }
  .directory-note p { margin: 12px 0 0; }
  .directory-actions { display: flex; flex-wrap: wrap; gap: 4px 24px; }
  .directory-actions a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 900px) {
    .directory-body { grid-template-columns: 1fr; gap: 24px; }
    .artist-index { position: static; }
    .artist-index ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 24px; }
  }
  @media (max-width: 600px) {
    .directory-intro { padding: 24px 18px 20px; }
    .directory-summary { gap: 10px; margin: 22px 0 16px; }
    .directory-summary div { padding-left: 10px; }
    .directory-summary dt { font-size: 11px; }
    .directory-summary dd { font-size: 25px; }
    .directory-summary dd span { margin-left: 4px; font-size: 12px; }
    .provider-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; padding-top: 14px; margin-bottom: 16px; }
    .provider-summary div { flex-direction: column; gap: 4px; }
    .provider-summary .both-provider-summary { grid-column: 1 / -1; flex-direction: row; align-items: baseline; gap: 12px; }
    .provider-summary dt { font-size: 12px; }
    .provider-summary dd { font-size: 21px; }
    .artist-directory .directory-scope { font-size: 12px; }
    .artist-directory .provider-count-note { font-size: 12px; }
    .both-search-action a { gap: 8px; padding: 0 10px; font-size: 13px; }
    .artist-directory .both-search-note { font-size: 12px; }
    .directory-help { margin: 28px 0 32px; }
    .directory-help ol { padding-left: 20px; }
    .directory-help li { font-size: 14px; }
    .artist-index { padding: 16px; }
    .artist-index ul { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 16px; }
    .artist-directory .artist-index li { font-size: 13px; }
    .artist-group { padding: 20px 18px; }
    .artist-directory .artist-heading h2 { font-size: 25px; }
    .artist-song h3 { font-size: 19px; }
    .artist-numbers { grid-template-columns: 1fr; gap: 10px; }
    .artist-number { padding: 12px 14px 6px; }
    .directory-note { padding: 20px 18px; }
    .artist-directory .directory-note h2 { font-size: 20px; }
    .directory-actions { font-size: 14px; }
  }
</style>
