---
import Icon from './Icon.astro';
import { songHref, type Song } from '../lib/catalog';
import { hasConfirmedNumber } from '../../contracts/public-catalog.mjs';
const { song } = Astro.props as { song: Song };
---
<li class="song-row" data-song-id={song.id}>
  <div class="song-name"><a href={songHref(song.id)}>{song.titleOriginal}</a><p>{[song.titleKo, song.artistKo || song.artistOriginal].filter(Boolean).join(' · ')}</p></div>
  {(['tj', 'ky'] as const).map(provider => {
    const value = song.karaoke[provider];
    const confirmed = hasConfirmedNumber(song, provider);
    return <div class="number-cell">
      <span class="mobile-label">{provider === 'tj' ? 'TJ' : '금영'}</span>
      {value.conflict ? <span class="unknown">번호 충돌 · 재확인 필요</span> : value.observedNumber ?
        <button type="button" class="number-button" data-copy={value.observedNumber} aria-label={`${song.titleOriginal} ${provider === 'tj' ? 'TJ' : '금영'} ${confirmed ? '공식 확인' : '관측'} 번호 ${value.observedNumber} 복사`}>{value.observedNumber}<Icon name="copy" /></button> :
        <span class="unknown">확인 필요</span>}
      {confirmed && <small class="verification-badge">공식 확인</small>}
    </div>;
  })}
  <button class="save-button" type="button" data-save={song.id} aria-pressed="false" aria-label={`${song.titleOriginal} 저장`} disabled><Icon name="star" /></button>
</li>
