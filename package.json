{
  "name": "jpoptoday",
  "version": "0.4.10",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "build": "astro build && node scripts/finalize-artifact.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test:e2e": "playwright test",
    "deploy:preview": "node scripts/deploy-preview.mjs",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "promote:catalog": "node scripts/promote-catalog.mjs",
    "audit:legacy": "node scripts/audit-legacy-source.mjs",
    "import:legacy": "node scripts/import-legacy-staging.mjs",
    "inspect:cloudflare": "python3 scripts/inspect-cloudflare.py",
    "deploy:production": "node scripts/deploy-production.mjs",
    "manage:production": "python3 scripts/manage-production.py",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "release:production": "bash scripts/release-production.sh"
  },
  "dependencies": {
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
  }
}
